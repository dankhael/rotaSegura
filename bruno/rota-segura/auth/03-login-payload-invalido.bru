meta {
  name: Login payload inválido (email faltando)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "password": "ChangeMe!123"
  }
}

tests {
  test("deve retornar 400", function() {
    expect(res.status).to.equal(400);
  });
  test("deve listar o campo 'email' no details", function() {
    expect(res.body.error).to.equal("Payload inválido");
    expect(res.body.details.some(d => d.field === "email")).to.be.true;
  });
}
