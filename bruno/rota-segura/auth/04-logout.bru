meta {
  name: Logout (limpa cookie httpOnly)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/logout
  body: none
  auth: none
}

tests {
  test("deve retornar 204", function() {
    expect(res.status).to.equal(204);
  });
  test("deve devolver Set-Cookie limpando o cookie token", function() {
    const setCookie = res.headers["set-cookie"];
    expect(setCookie).to.exist;
    // Pode vir como string ou array dependendo do runtime; normaliza para string.
    const cookieHeader = Array.isArray(setCookie) ? setCookie.join("; ") : String(setCookie);
    expect(cookieHeader).to.match(/token=/i);
    expect(cookieHeader.toLowerCase()).to.include("max-age=0");
    expect(cookieHeader.toLowerCase()).to.include("httponly");
  });
  test("body vazio (204 No Content)", function() {
    expect(res.body).to.satisfy(function(b) {
      return b === undefined || b === null || b === "";
    });
  });
}
