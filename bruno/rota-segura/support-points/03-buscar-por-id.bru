meta {
  name: Buscar ponto por ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/support-points/{{supportPointId}}
  body: none
  auth: none
}

tests {
  test("deve retornar 200", function() {
    expect(res.status).to.equal(200);
  });
  test("deve retornar o ponto correto", function() {
    expect(res.body.id).to.equal(bru.getVar("supportPointId"));
  });
}
