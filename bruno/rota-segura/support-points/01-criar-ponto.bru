meta {
  name: Criar ponto de apoio
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/support-points
  body: json
  auth: none
}

body:json {
  {
    "name": "Abrigo Comunitário Central",
    "type": "SHELTER",
    "latitude": -8.057838,
    "longitude": -34.882750,
    "capacity": 300
  }
}

script:post-response {
  // Salva o id para usar nas requisições seguintes
  if (res.status === 201) {
    bru.setVar("supportPointId", res.body.id);
  }
}

tests {
  test("deve retornar 201", function() {
    expect(res.status).to.equal(201);
  });
  test("deve ter id no retorno", function() {
    expect(res.body.id).to.be.a("string");
  });
}
