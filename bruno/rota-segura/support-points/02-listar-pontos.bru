meta {
  name: Listar pontos de apoio
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/support-points?page=1&limit=10
  body: none
  auth: none
}

tests {
  test("deve retornar 200", function() {
    expect(res.status).to.equal(200);
  });
  test("deve ter array data e meta", function() {
    expect(res.body.data).to.be.an("array");
    expect(res.body.meta).to.have.property("total");
    expect(res.body.meta).to.have.property("page");
    expect(res.body.meta).to.have.property("limit");
    expect(res.body.meta).to.have.property("totalPages");
  });
}
