meta {
  name: Buscar ocorrência por ID (agregado)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/occurrences/{{occurrenceId}}
  body: none
  auth: none
}

tests {
  test("retorna 200", function() {
    expect(res.status).to.equal(200);
  });
  test("retorna a ocorrência correta com campos do agregado", function() {
    expect(res.body.id).to.equal(bru.getVar("occurrenceId"));
    expect(res.body).to.have.property("status");
    expect(res.body).to.have.property("reportCount");
    expect(res.body).to.have.property("uniqueDeviceCount");
    expect(res.body).to.have.property("centroidLatitude");
    expect(res.body).to.have.property("firstReportedAt");
    expect(res.body).to.have.property("lastReportedAt");
  });
}
