meta {
  name: Registrar ocorrência
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/occurrences
  body: json
  auth: none
}

body:json {
  {
    "type": "FLOOD",
    "latitude": -8.057838,
    "longitude": -34.882750
  }
}

script:post-response {
  // Salva o id para usar nas requisições seguintes
  if (res.status === 201) {
    bru.setVar("occurrenceId", res.body.id);
  }
}

tests {
  test("deve retornar 201", function() {
    expect(res.status).to.equal(201);
  });
  test("deve ter id no retorno", function() {
    expect(res.body.id).to.be.a("string");
  });
  test("deve conter type, latitude, longitude, occurredAt e createdAt", function() {
    expect(res.body.type).to.equal("FLOOD");
    expect(res.body.latitude).to.be.a("number");
    expect(res.body.longitude).to.be.a("number");
    expect(res.body.occurredAt).to.be.a("string");
    expect(res.body.createdAt).to.be.a("string");
  });
}
