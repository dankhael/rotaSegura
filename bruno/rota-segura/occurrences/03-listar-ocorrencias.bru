meta {
  name: Listar ocorrências (agregados)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/occurrences?page=1&limit=10
  body: none
  auth: none
}

tests {
  test("retorna 200", function() {
    expect(res.status).to.equal(200);
  });
  test("estrutura data + meta", function() {
    expect(res.body.data).to.be.an("array");
    expect(res.body.meta).to.have.all.keys("total", "page", "limit", "totalPages");
  });
  test("itens são agregados (status, reportCount, centroidLatitude)", function() {
    if (res.body.data.length > 0) {
      const first = res.body.data[0];
      expect(first).to.have.property("status");
      expect(first).to.have.property("reportCount");
      expect(first).to.have.property("uniqueDeviceCount");
      expect(first).to.have.property("centroidLatitude");
      expect(first).to.have.property("centroidLongitude");
    }
  });
}
