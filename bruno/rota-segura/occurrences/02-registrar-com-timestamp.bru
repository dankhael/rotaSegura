meta {
  name: Registrar ocorrência com timestamp do cliente
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/occurrences
  body: json
  auth: none
}

body:json {
  {
    "type": "FLOOD",
    "latitude": -8.063,
    "longitude": -34.871,
    "occurredAt": "2025-01-15T10:30:00.000Z"
  }
}

tests {
  test("deve retornar 201", function() {
    expect(res.status).to.equal(201);
  });
  test("deve preservar o occurredAt fornecido", function() {
    expect(res.body.occurredAt).to.equal("2025-01-15T10:30:00.000Z");
  });
}
