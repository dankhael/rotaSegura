meta {
  name: Resumo do dashboard (admin)
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/occurrences/summary?type=FLOOD
  body: none
  auth: none
}

docs {
  Resumo agregado para o dashboard admin (US10). Exige sessão de ADMIN:
  rode antes "auth/Login admin (sucesso)" para o cookie httpOnly entrar no
  cookie jar do Bruno. `type` e `status` são filtros opcionais e combináveis.
}

tests {
  test("retorna 200 com sessão de admin", function() {
    expect(res.status).to.equal(200);
  });
  test("expõe total e quebra por status", function() {
    expect(res.body.total).to.be.a("number");
    expect(res.body.byStatus).to.have.property("pending");
    expect(res.body.byStatus).to.have.property("confirmed");
  });
  test("agrupa por região", function() {
    expect(res.body.regions).to.be.an("array");
  });
  test("ecoa os filtros aplicados", function() {
    expect(res.body.filters).to.deep.equal({ status: null, type: "FLOOD" });
  });
}
