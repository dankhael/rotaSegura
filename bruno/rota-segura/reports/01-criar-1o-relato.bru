meta {
  name: Criar 1º relato (cria occurrence PENDING)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/reports
  body: json
  auth: none
}

body:json {
  {
    "type": "FLOOD",
    "latitude": -8.057838,
    "longitude": -34.882750,
    "deviceId": "{{deviceId1}}"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("reportId", res.body.report.id);
    bru.setVar("occurrenceId", res.body.occurrence.id);
  }
}

tests {
  test("retorna 201 (relato novo)", function() {
    expect(res.status).to.equal(201);
  });
  test("cria occurrence PENDING com reportCount=1, uniqueDeviceCount=1 (AC1, AC3)", function() {
    expect(res.body.occurrence.status).to.equal("PENDING");
    expect(res.body.occurrence.reportCount).to.equal(1);
    expect(res.body.occurrence.uniqueDeviceCount).to.equal(1);
  });
  test("centroid = ponto do relato (AC5)", function() {
    expect(res.body.occurrence.centroidLatitude).to.be.closeTo(-8.057838, 0.0001);
    expect(res.body.occurrence.centroidLongitude).to.be.closeTo(-34.882750, 0.0001);
  });
  test("clustering.created=true", function() {
    expect(res.body.clustering.created).to.equal(true);
    expect(res.body.clustering.promoted).to.equal(false);
    expect(res.body.clustering.duplicateDevice).to.equal(false);
  });
}
