meta {
  name: Relato fora do raio (~2km — cria nova occurrence)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/reports
  body: json
  auth: none
}

body:json {
  {
    "type": "FLOOD",
    "latitude": -8.078000,
    "longitude": -34.900000,
    "deviceId": "44444444-4444-4444-8444-444444444444"
  }
}

tests {
  test("retorna 201", function() {
    expect(res.status).to.equal(201);
  });
  test("cria nova occurrence (AC1 negativo)", function() {
    expect(res.body.clustering.created).to.equal(true);
    expect(res.body.occurrence.id).to.not.equal(bru.getVar("occurrenceId"));
  });
  test("nova occurrence PENDING isolada", function() {
    expect(res.body.occurrence.status).to.equal("PENDING");
    expect(res.body.occurrence.reportCount).to.equal(1);
  });
}
