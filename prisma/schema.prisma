generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, postgis_topology, postgis_tiger_geocoder, fuzzystrmatch]
}

model SupportPoint {
  id        String   @id @default(cuid())
  name      String
  type      String 
  capacity  Int?
  latitude  Float    // Adicione este campo[cite: 1, 4, 5]
  longitude Float    // Adicione este campo[cite: 1, 4, 5]
  location  Unsupported("geography(Point, 4326)")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([location], type: Gist)
  @@map("support_points") // Mapeia para snake_case no banco
}
