generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Vercel Functions rodam em Amazon Linux (rhel-openssl-3.0.x). O deploy via
  // GitHub Actions (ubuntu-latest) gera o engine "native" debian e o envia com
  // `vercel deploy --prebuilt`, então o engine RHEL precisa ser embarcado junto.
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, postgis_topology, postgis_tiger_geocoder, fuzzystrmatch]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  // role validado em camada de aplicação: ADMIN | USER.
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@map("users")
}

enum OccurrenceStatus {
  PENDING
  CONFIRMED
}

// Agregado de relatos próximos (US06).
// Estado derivado: contadores e centróide são recalculados a cada novo report.
model Occurrence {
  id                String           @id @default(cuid())
  // type validado em camada de aplicação: FLOOD | FIRE | LANDSLIDE | ACCIDENT | OBSTRUCTION | OTHER.
  type              String
  status            OccurrenceStatus @default(PENDING)
  centroidLatitude  Float
  centroidLongitude Float
  centroid          Unsupported("geography(Point, 4326)")
  reportCount       Int              @default(0)
  uniqueDeviceCount Int              @default(0)
  firstReportedAt   DateTime
  lastReportedAt    DateTime
  confirmedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now())
  reports           Report[]

  @@index([centroid], type: Gist)
  @@index([type, lastReportedAt])
  @@index([status])
  @@map("occurrences")
}

// Relato individual (evento bruto). Sempre pertence a uma Occurrence (FK NOT NULL).
// Idempotência por (occurrenceId, deviceId) é garantida por unique parcial em SQL puro
// (não expressável em @@unique do Prisma); ver migration 20260519180000.
model Report {
  id           String     @id @default(cuid())
  type         String
  latitude     Float
  longitude    Float
  location     Unsupported("geography(Point, 4326)")
  occurredAt   DateTime   @default(now())
  createdAt    DateTime   @default(now())
  deviceId     String?
  occurrenceId String
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@index([location], type: Gist)
  @@index([occurrenceId])
  @@index([deviceId])
  @@index([type, occurredAt(sort: Desc)])
  @@map("reports")
}

model SupportPoint {
  id        String   @id @default(cuid())
  name      String
  // type validado em camada de aplicação: SHELTER | MEDICAL | SUPPLY | OTHER.
  // Promover a enum Postgres ou CHECK constraint quando o conjunto estabilizar.
  type      String
  capacity  Int?
  latitude  Float
  longitude Float
  location  Unsupported("geography(Point, 4326)")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluations SupportPointEvaluation[]

  @@index([location], type: Gist)
  @@map("support_points")
}

model DonationChannel {
  id           String   @id @default(cuid())
  title        String
  description  String
  // channelType validado em camada de aplicação: PIX_KEY | QR_CODE | EXTERNAL_LINK.
  channelType  String
  channelValue String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([channelType])
  @@map("donation_channels")
}

model SupportPointEvaluation {
  id             String   @id @default(uuid())
  rating         Int      // De 1 a 5
  comment        String?  @db.Text // Relato opcional (Máximo 280 caracteres)
  deviceId       String   // Para prevenção de spam
  createdAt      DateTime @default(now())
  
  // Relação com o ponto de apoio
  supportPoint   SupportPoint @relation(fields: [supportPointId], references: [id])
  supportPointId String

  @@index([supportPointId])
  @@map("support_point_evaluations")
}
