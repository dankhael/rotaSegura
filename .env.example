DATABASE_URL="postgresql://rotasegura:rotasegura@localhost:5432/rotasegura?schema=public"

# Auth — JWT
# Gere um segredo forte: openssl rand -base64 32
JWT_SECRET="troque-este-valor-em-prod-pelo-menos-32-chars-aaaaaaaaa"
# Tempo de vida do token. Aceita ms ("3600000") ou string vercel/ms ("1h", "30m", "7d")
JWT_EXPIRES_IN="1h"

# Seed do admin inicial (usado por `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@rotasegura.local"
SEED_ADMIN_PASSWORD="ChangeMe!123"

# Agrupamento de relatos (US06). Alterar no Vercel não requer novo deploy.
CLUSTER_RADIUS_M=200
CLUSTER_WINDOW_MIN=120
CLUSTER_THRESHOLD=3

# Janela de validade (min) de uma ocorrência no mapa público (RS-TK05).
# Expirar não apaga nada: a ocorrência continua no banco para auditoria.
OCCURRENCE_ACTIVE_WINDOW_MIN=1440

# Web Push / VAPID (RS-TK04). Gere com:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# A pública também é exposta ao frontend via NEXT_PUBLIC_VAPID_PUBLIC_KEY — mantenha
# os dois em sincronia. A privada NUNCA pode vazar para o cliente.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@rotasegura.local"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Raio (em km) para notificar usuários próximos a uma nova ocorrência.
NOTIFICATION_RADIUS_KM=2

# Teto de destinatários por disparo — corta o fan-out em áreas densas para
# proteger a Function. Subir conforme a base crescer; valores acima de ~2000
# devem virar processamento em lotes.
NOTIFICATION_MAX_RECIPIENTS=500
