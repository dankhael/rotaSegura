DATABASE_URL="postgresql://rotasegura:rotasegura@localhost:5432/rotasegura?schema=public"

# Auth — JWT
# Gere um segredo forte: openssl rand -base64 32
JWT_SECRET="troque-este-valor-em-prod-pelo-menos-32-chars-aaaaaaaaa"
# Tempo de vida do token. Aceita ms ("3600000") ou string vercel/ms ("1h", "30m", "7d")
JWT_EXPIRES_IN="1h"

# Seed do admin inicial (usado por `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@rotasegura.local"
SEED_ADMIN_PASSWORD="ChangeMe!123"

# Agrupamento de relatos (US06). Alterar no Vercel não requer novo deploy.
CLUSTER_RADIUS_M=200
CLUSTER_WINDOW_MIN=120
CLUSTER_THRESHOLD=3
